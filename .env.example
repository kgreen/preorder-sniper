# Copy this file to .env and configure only the settings you use.
# Never commit .env or a browser profile.
POLL_INTERVAL_SECONDS=5
POLL_JITTER_SECONDS=1
REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_URL=
# Seconds to suppress repeat alerts for the same product (0 disables de-duplication).
ALERT_COOLDOWN_SECONDS=300

# Alert channels: use either webhook, SMS, or both at once.
# SMS notifications (Twilio). Leave blank to disable SMS alerts.
SMS_TO_NUMBER=
TWILIO_FROM_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
